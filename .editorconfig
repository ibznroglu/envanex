root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4

# Treat these as errors, not suggestions
dotnet_diagnostic.CA1062.severity = warning   # validate public arguments
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait not needed in ASP.NET Core
dotnet_diagnostic.CS8618.severity = error     # non-nullable field uninitialized
dotnet_diagnostic.CS8602.severity = error     # possible null dereference

csharp_style_var_for_built_in_types = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_prefer_braces = true:warning
dotnet_style_readonly_field = true:warning
dotnet_sort_system_directives_first = true

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.sql]
indent_size = 4

# Test projects: allow underscores in method names (standard test naming convention)
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
