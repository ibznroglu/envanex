      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(node --test .claude/hooks/tests/guard-common.test.js)",
      "Bash(node --test .claude/hooks/tests/path-guard.test.js)",
      "Bash(node --test .claude/hooks/tests/*.test.js)"
    ],
    "deny": [
      "Bash(git stash)",
      "PowerShell(git stash)",
      "Bash(git stash *)",
      "PowerShell(git stash *)",
      "Bash(git clean *)",
      "PowerShell(git clean *)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git checkout -- *)",
      "PowerShell(git checkout -- *)",
      "Bash(git checkout .)",
      "PowerShell(git checkout .)",
      "Bash(git checkout -f*)",
      "PowerShell(git checkout -f*)",
      "Bash(git switch -f*)",
