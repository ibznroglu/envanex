  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/path-guard.js\" || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);const p=(j.tool_input&&(j.tool_input.file_path||j.tool_input.path))||'';if(!/\\.(cs|csproj)$/.test(p))return;require('child_process').execSync('dotnet format --no-restore --include \\\"'+p+'\\\" 2>&1 | tail -5',{stdio:'inherit'})}catch(e){}})\""
          }
        ]
      }
    ]
  }
}
