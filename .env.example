# Local development settings for docker-compose.yml. Copy this file to .env and
# fill in the value. .env is git-ignored; never commit it.
#
# MSSQL_SA_PASSWORD is the SA password of the local SQL Server container.
# - SQL Server's policy: at least 8 characters, from at least three of these four
#   sets: uppercase, lowercase, digits, symbols. A password that fails it makes
#   the container exit on first start.
# - Avoid $, #, ; and quote characters: $ and # have special meaning in this file,
#   and ; ends the value in a connection string.
# - SQL Server applies the value only when it creates the data volume. To change
#   it, recreate the volume: `docker compose down -v`, then `docker compose up -d`.
#   That deletes the local database; re-run the migrations.
#
# The same password lives in two more places, and all three must match:
# - the ConnectionStrings:EnvanexDb user-secret, which the app reads
#   (dotnet user-secrets set ... --project src/Envanex.Web);
# - ENVANEX_CONNECTION_STRING, which the dotnet ef commands read.
# Both use this shape. Use 127.0.0.1, not localhost: the port is bound to IPv4
# loopback, and Windows resolves localhost to ::1 first.
#   Server=127.0.0.1,1433;Database=EnvanexDev;User Id=sa;Password=<password>;TrustServerCertificate=True
MSSQL_SA_PASSWORD=
