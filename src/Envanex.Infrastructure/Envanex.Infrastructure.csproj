<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="Envanex.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Envanex.Domain\Envanex.Domain.csproj" />
    <ProjectReference Include="..\Envanex.Application\Envanex.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Security override only: no Infrastructure code uses Pkcs. The chain is EF Core SqlServer
         10.0.11 -> Microsoft.Data.SqlClient 6.1.6 -> System.Security.Cryptography.Pkcs 9.0.11,
         affected by GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. It is a direct reference because
         the central PackageVersion alone does not reach a transitive dependency. Remove it, together
         with its PackageVersion, once EF Core SqlServer brings a patched Pkcs on its own. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- Signing lives here, so the JWT handler is referenced here and never by Application. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <!-- services.Configure<JwtOptions>(section) and section.Get<JwtOptions>() are declared by
         these two. Both already arrive transitively through EF Core, so the references are
         belt and braces at the same version: no NU1605, and the build no longer depends on
         another package's dependency graph continuing to carry them. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>
</Project>
