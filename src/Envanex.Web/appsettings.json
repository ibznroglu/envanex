{
  "ConnectionStrings": {
    "EnvanexDb": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "https://envanex.local",
    "Audience": "envanex-api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenIdleDays": 7,
    "RefreshTokenAbsoluteDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
